# Normalize all text files to LF in the repo and working tree.
# Prevents CRLF/LF churn between Windows checkouts and the committed blobs.
* text=auto eol=lf

# Binary assets - never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.pdf binary
*.exe binary
